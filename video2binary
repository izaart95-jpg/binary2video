#!/usr/bin/env python3
# video2binary (v4, python) -- decode a video made by binary2video back
# into the exact original binary file.
#
# Steps:
#   1. ffprobe the file: does it have a video stream (+ how many audio)?
#   2. decode video stream to raw RGB-24 bytes       (payload part 1)
#   3. decode every audio track to raw s16le bytes   (payload part 2)
#   4. read the 54-byte ASCII header:
#        "B2V3" + flag + orig_len(15) + video_bytes(15) + audio_bytes(15)
#              + channels(2) + tracks(2)
#      stream = video_bytes[54..] + concat of the tracks[:audio_bytes]
#      flag 'z' -> gunzip stream, must yield orig_len bytes
#      flag 'r' -> truncate stream to orig_len
#   5. fall back automatically for older formats:
#        'B2V2' + flag + orig_len(15) + video(15) + audio(15)   (mono, 1 track)
#        'B2V1' + flag + orig_len(15) + stream_len(15)         (video only)
#        no header at all = the original gzip+pad format: gunzip everything
#
# B2V4 "plates" are auto-detected (no flags): gray cell grids carrying a
# Reed-Solomon protected stream (made by binary2video -y). They survive
# lossy platform re-encoding; needs b2v_rs.py next to this script.
#
# Usage: video2binary [-v] infile outfile

import argparse
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile
import zlib

MAGIC_V3 = b"B2V3"; HDR_V3 = 54
MAGIC_V2 = b"B2V2"; HDR_V2 = 50
MAGIC_V1B = b"B2V1";  HDR_V1B = 35

#--- platform mode (B2V4 plates; auto-detected, no flags needed) -----------
YT_CELL = 10
YT_PARITY = 64
YT_K = 159
YT_META = 35
YT_LEVELS = {2: (40, 220),
             4: (40, 100, 160, 220),
             8: (40, 66, 91, 117, 143, 169, 194, 220)}


def load_rs():
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import b2v_rs
        return b2v_rs
    except ImportError:
        fail("b2v_rs.py is missing next to this script (needed for B2V4 plates)", 2)


def _cell_gray(img, W, cy, cx):
    """Mean gray of a cell's inner area (2px inset kills boundary ringing)."""
    s = n = 0
    for y in range(cy * YT_CELL + 2, (cy + 1) * YT_CELL - 2):
        base = (y * W + cx * YT_CELL + 2) * 3
        for _ in range(YT_CELL - 4):
            s += img[base] + img[base + 1] + img[base + 2]
            base += 3
    return s / (3.0 * (YT_CELL - 4) ** 2)


def _ramp_ok(vals, M):
    """Calibration ramp sanity for one frame (used to reject blended frames)."""
    ramp = vals[:M]
    if not all(ramp[i + 1] - ramp[i] >= 8 for i in range(M - 1)):
        return False
    if ramp[-1] - ramp[0] < 70:
        return False
    if abs(vals[M] - ramp[0]) > 10:
        return False
    return True


def detect_b2v4(v_raw, W, H, n_frames):
    """Scan frames for the ramp signature. Returns (M, start_frame) or None."""
    if W % YT_CELL or H % YT_CELL:
        return None
    cols, rows = W // YT_CELL, H // YT_CELL
    if n_frames < 1 or cols < 9 or rows < 3:
        return None
    for M in (8, 4, 2):
        for f in range(n_frames):
            img = v_raw[f * W * H * 3:(f + 1) * W * H * 3]
            vals = [_cell_gray(img, W, 0, c) for c in range(M + 1)]
            if _ramp_ok(vals, M):
                return M, f
    return None


def demod_b2v4(v_raw, W, H, M, start_frame):
    """Frame-index-aware demod: (index -> symbols), order/dup/garbage-tolerant.

    Returns (bytes, stats): the whole protected stream as bytes plus a
    statistics dict about what the platform did to the frames.
    """
    bps = M.bit_length() - 1
    cols, rows = W // YT_CELL, H // YT_CELL
    fsize = W * H * 3
    n_frames = len(v_raw) // fsize
    sections = {}
    stats = {"kept": 0, "dups": 0, "skipped": 0, "conflicts": 0}
    for f in range(start_frame, n_frames):
        img = v_raw[f * fsize:(f + 1) * fsize]
        vals = [_cell_gray(img, W, 0, c) for c in range(M + 1)]
        if not _ramp_ok(vals, M):
            stats["skipped"] += 1
            continue
        idx = 0
        for c in range(8):
            g = _cell_gray(img, W, 1, c)
            idx = idx * M + min(range(M), key=lambda j: abs(g - vals[j]))
        if idx >= M ** 8:
            stats["skipped"] += 1
            continue
        vec = []
        for r in range(2, rows):
            for c in range(cols):
                g = _cell_gray(img, W, r, c)
                vec.append(min(range(M), key=lambda j: abs(g - vals[j])))
        if idx in sections:
            if sections[idx] == vec:
                stats["dups"] += 1
                continue
            stats["conflicts"] += 1          # keep the first seen copy
            continue
        sections[idx] = vec
        stats["kept"] += 1
    if not sections:
        fail("B2V4 plate found but no frame had a readable index", 9)
    keys = sorted(sections)
    if keys != list(range(keys[-1] + 1)):
        fail(f"B2V4 plate has gaps in its frame sequence: got indices "
             f"{keys}; a payload frame was lost or mangled beyond the "
             f"transcode channel", 9)
    bits = []
    for idx in keys:
        for sym in sections[idx]:
            for k in range(bps - 1, -1, -1):
                bits.append((sym >> k) & 1)
    out = bytearray()
    for i in range(0, len(bits) - 7, 8):
        out.append(sum(bits[i + j] << (7 - j) for j in range(8)))
    stats["cells_frame"] = (rows - 2) * cols
    return bytes(out), stats


def try_b2v4(v_raw, W, H, args):
    """Decode a B2V4 plate file. None = not a plate; str/bytes = payload."""
    fsize = W * H * 3
    if len(v_raw) % fsize != 0:
        return None
    det = detect_b2v4(v_raw, W, H, len(v_raw) // fsize)
    if det is None:
        return None
    M, start = det
    b2v_rs = load_rs()

    blob, stats = demod_b2v4(v_raw, W, H, M, start)
    if len(blob) < YT_K + YT_PARITY:
        fail(f"B2V4 plate detected but only {len(blob)} B came out of the "
             f"grid: video too short or resized", 9)
    try:
        data, fixed0 = b2v_rs.rs_repair(blob[:YT_K + YT_PARITY], YT_K)
    except b2v_rs.RSUnfixable:
        fail("B2V4 plate detected but the protected header did not repair: "
             "the platform re-encoded, resized or cropped the video harder "
             "than the Reed-Solomon budget allows", 9)
    if data[:4] != b"B2V4":
        fail("B2V4 plate detected but its header is not intact", 9)
    flag = data[4:5]
    orig_len = int(data[5:20])
    stream_len = int(data[20:35])
    if flag not in (b"r", b"z"):
        fail("B2V4 header flag is not r/z (corrupt after repair?)", 8)

    total = YT_META + stream_len
    n_blocks = max(1, -(-total // YT_K))
    chunks = [data]
    fixed_total = fixed0
    pos = YT_K + YT_PARITY
    for i in range(1, n_blocks):
        need = YT_K + YT_PARITY                           # uniform 223 on wire
        if pos + need > len(blob):
            fail("B2V4 plate ends before its last block (truncated video?)", 9)
        try:
            block, nf = b2v_rs.rs_repair(blob[pos:pos + need], YT_K)
        except b2v_rs.RSUnfixable:
            fail(f"B2V4 block {i} exceeds the Reed-Solomon repair budget: "
                 f"damage too heavy for this plate", 9)
        chunks.append(block)
        fixed_total += nf
        pos += need
    full = b"".join(chunks)
    stream = full[YT_META:YT_META + stream_len]
    if flag == b"z":
        out = gunzip_or_die(stream)
        if len(out) != orig_len:
            fail(f"gunzip yielded {len(out)} bytes, header says {orig_len}", 8)
    else:
        if len(stream) < orig_len:
            fail(f"payload is {len(stream)} bytes but header claims {orig_len}", 8)
        out = stream[:orig_len]

    if args.verbose:
        print(f"B2V4 plate: {M} levels, {n_blocks} RS block(s); frames kept "
              f"{stats['kept']} (dup {stats['dups']}, garbled+skipped "
              f"{stats['skipped']}, conflict {stats['conflicts']})")
        print(f"RS repaired {fixed_total} damaged byte(s), budget "
              f"{YT_PARITY // 2}/block")
        print(f"flag={flag.decode()} orig_len={orig_len} stream={stream_len} B")
    return out


def fail(msg, code):
    sys.stderr.write(f"error: {msg}\n")
    sys.exit(code)


def run_or_die(cmd, what):
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if proc.returncode != 0:
        lines = proc.stderr.decode(errors="replace").strip().splitlines()
        fail(f"while {what}: {lines[-1] if lines else '(no stderr)'}", 7)
    return proc.stdout


def gzip_decompress(raw):
    """Tolerant gunzip: accepts trailing zero padding / garbage after the stream."""
    z = zlib.decompressobj(31)              # wbits=31 -> gzip format
    return z.decompress(raw) + z.flush()


def gunzip_or_die(raw):
    """gunzip that turns corruption into an explanation instead of a traceback."""
    try:
        return gzip_decompress(raw)
    except zlib.error:
        fail("the pixels do not decode back into data: this video was re-encoded "
             "somewhere along the way (YouTube, a chat app, an editor...) and "
             "lossless payload data does not survive that. Extract from the file "
             "binary2video produced, before any platform touched it.", 9)


def main():
    ffmpeg = shutil.which("ffmpeg")
    ffprobe = shutil.which("ffprobe")
    if not ffmpeg or not ffprobe:
        fail("ffmpeg/ffprobe not found", 2)

    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("infile")
    p.add_argument("outfile")
    if len(sys.argv) == 1 or "--help" in sys.argv:
        print(__doc__)
        sys.exit(0 if "--help" in sys.argv else 2)
    args = p.parse_args()

    if not os.access(args.infile, os.R_OK):
        fail(f"'{args.infile}' does not exist or is not readable", 4)
    outdir = os.path.dirname(os.path.abspath(args.outfile))
    os.makedirs(outdir, exist_ok=True)

    probes = run_or_die(
        [ffprobe, "-v", "error", "-show_entries", "stream=codec_type",
         "-of", "default=nw=1:nk=1", args.infile], "probing video").decode()
    kinds = [line.split("=")[-1].strip() for line in probes.splitlines() if line.strip()]
    audio_streams = sum(1 for k in kinds if k == "audio")
    if "video" not in kinds:
        fail("no video stream found -- is this a binary2video output?", 8)

    dims = run_or_die([ffprobe, "-v", "error", "-select_streams", "v:0",
                       "-show_entries", "stream=width,height",
                       "-of", "csv=p=0", args.infile], "probing size").decode().strip()
    try:
        W, H = (int(v) for v in dims.splitlines()[0].split(","))
    except ValueError:
        fail(f"could not read video dimensions ({dims!r})", 8)
    if W <= 0 or H <= 0:
        fail(f"nonsense video dimensions ({W}x{H})", 8)

    work = tempfile.mkdtemp(prefix="v2b.")
    try:
        run_or_die([ffmpeg, "-y", "-loglevel", "error", "-i", args.infile,
                    "-f", "rawvideo", "-pix_fmt", "rgb24",
                    os.path.join(work, "v.raw")], "decoding video")
        with open(os.path.join(work, "v.raw"), "rb") as fh:
            v_raw = fh.read()

        plate_out = try_b2v4(v_raw, W, H, args)
        if plate_out is not None:
            with open(args.outfile, "wb") as fh:
                fh.write(plate_out)
            sys.exit(0)

        #----- read header / payload -----------------------------------
        if v_raw[:4] in (MAGIC_V3, MAGIC_V2):
            version = v_raw[:4].decode()
            hdr_len = HDR_V3 if version == "B2V3" else HDR_V2
            flag = v_raw[4:5]
            orig_len = int(v_raw[5:20])
            v_bytes = int(v_raw[20:35])
            a_bytes = int(v_raw[35:50])
            if version == "B2V3":
                channels = int(v_raw[50:52])
                tracks = int(v_raw[52:54])
            else:
                channels, tracks = 1, 1
            if flag not in (b"r", b"z"):
                fail(f"corrupt {version} header: unknown flag {flag!r}", 6)
            if not 1 <= channels <= 8 or not 1 <= tracks <= 8:
                fail(f"corrupt {version} header: bad channels/tracks", 6)
            if a_bytes > 0:
                if audio_streams < tracks:
                    fail(f"{version} header says {tracks} audio tracks, "
                         f"file has {audio_streams} (truncated or foreign file?)", 8)
                a_raw = b""
                for i in range(tracks):
                    run_or_die([ffmpeg, "-y", "-loglevel", "error", "-i", args.infile,
                                "-vn", "-map", f"0:a:{i}", "-f", "s16le",
                                os.path.join(work, f"a{i}.raw")], f"decoding audio track {i}")
                    with open(os.path.join(work, f"a{i}.raw"), "rb") as fh:
                        a_raw += fh.read()
            else:
                a_raw = b""
                tracks = 1  # nothing stored in audio; header fields may be bogus
            if len(v_raw) < hdr_len + v_bytes:
                fail("video track shorter than header expects (truncated video?)", 8)
            if len(a_raw) < a_bytes:
                fail("audio tracks shorter than header expects (truncated video?)", 8)
            stream = v_raw[hdr_len:hdr_len + v_bytes] + a_raw[:a_bytes]
            if flag == b"r" and len(stream) != orig_len:
                fail(f"payload is {len(stream)} bytes but header claims {orig_len}; corrupt header", 8)
            if flag == b"z":
                out = gunzip_or_die(stream)
                if len(out) != orig_len:
                    fail(f"gunzip yielded {len(out)} bytes, header says {orig_len}", 8)
            else:
                out = stream[:orig_len]
            if args.verbose:
                print(f"{version} header ok: flag={flag.decode()} orig_len={orig_len} "
                      f"video_bytes={v_bytes} audio_bytes={a_bytes} "
                      f"ch={channels} tracks={tracks} (file has {audio_streams})")
        elif v_raw[:4] == MAGIC_V1B and len(v_raw) >= HDR_V1B:
            flag = v_raw[4:5]
            orig_len = int(v_raw[5:20])
            stream_len = int(v_raw[20:35])
            if len(v_raw) < HDR_V1B + stream_len:
                fail("v1 video shorter than header expects (truncated?)", 8)
            stream = v_raw[HDR_V1B:HDR_V1B + stream_len]
            if flag == b"r" and stream_len != orig_len:
                fail(f"payload is {stream_len} bytes but header claims {orig_len}; corrupt header", 8)
            if flag == b"z":
                out = gunzip_or_die(stream)
                if len(out) != orig_len:
                    fail(f"gunzip yielded {len(out)} bytes, header says {orig_len}", 8)
            else:
                out = stream[:orig_len]
            if args.verbose:
                print(f"B2V1 header ok: flag={flag.decode()} orig_len={orig_len} stream_len={stream_len}")
        else:
            if args.verbose:
                print("no B2Vx header found -> legacy gzip+pad mode")
            out = gunzip_or_die(v_raw)

        with open(args.outfile, "wb") as fh:
            fh.write(out)
        if args.verbose:
            print(f"output: {len(out)} bytes   MD5: {hashlib.md5(out).hexdigest()}")
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    main()
